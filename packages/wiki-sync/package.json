{
  "name": "@plane/wiki-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Export a Plane workspace Wiki to a Docusaurus docs instance (CommonMark .md + _category_.json)",
  "license": "AGPL-3.0",
  "bin": {
    "plane-wiki-sync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@plane/typescript-config": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-mdast": "catalog:",
    "rehype-parse": "catalog:",
    "rehype-raw": "7.0.0",
    "rehype-remark": "catalog:",
    "remark-gfm": "catalog:",
    "remark-stringify": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "5.0.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
